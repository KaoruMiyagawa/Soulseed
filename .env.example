SOULSEED_ENVIRONMENT=development
SOULSEED_HOST=127.0.0.1
SOULSEED_PORT=8001
SOULSEED_DATABASE_PATH=backend/data/soulseed-development.db
SOULSEED_MODEL_BASE_URL=https://api.siliconflow.cn/v1
SOULSEED_MODEL_API_KEY=
SOULSEED_MODEL_NAME=deepseek-ai/DeepSeek-V4.1-Flash
SOULSEED_MODEL_TIMEOUT_SECONDS=60
# 可选：填写已确认的大肥鱼人格补充约束；默认人格资料始终加载，此变量不会替换核心人格。
SOULSEED_SYSTEM_PROMPT=
SOULSEED_MEMORY_CONTEXT_MAX_CHARS=4000
SOULSEED_MEMORY_CONTEXT_MAX_ITEMS=5
SOULSEED_MEMORY_ITEM_MAX_CHARS=600
SOULSEED_LIFE_TIMEZONE=Asia/Shanghai
SOULSEED_LIFE_BACKGROUND_ENABLED=true
SOULSEED_LIFE_BACKGROUND_INTERVAL_MINUTES=30
SOULSEED_CONTACT_ENABLED=true
SOULSEED_CONTACT_BACKGROUND_ENABLED=true
SOULSEED_CONTACT_CHECK_INTERVAL_MINUTES=60
# 本地配对口令：由本机操作者生成至少 32 字符的随机值，禁止提交真实口令。
# 留空时数据接口保持锁定；只支持本地回环运行。
SOULSEED_LOCAL_PAIRING_SECRET=
# production 环境不会自动执行待升级迁移。只有完成独立备份后，才填写备份路径和精确版本确认（例如 13->14）。
SOULSEED_MIGRATION_BACKUP_PATH=
SOULSEED_MIGRATION_CONFIRMATION=
# 仅当必须访问已存在的受保护数据时启用；确认值必须是目标数据库的规范化绝对路径。
SOULSEED_ALLOW_PROTECTED_DATABASE_ACCESS=false
SOULSEED_PROTECTED_DATABASE_CONFIRMATION=

