{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soulseed",
  "version": "2.9.1-beta.10",
  "identifier": "com.soulseed.desktop",
  "build": {
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Soulseed",
        "width": 1380,
        "height": 900,
        "minWidth": 820,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Soulseed",
    "shortDescription": "Soulseed Windows 体验版",
    "icon": ["icons/icon.ico", "icons/icon-32.png", "icons/icon-128.png", "icons/icon-256.png"],
    "resources": {
      "../../desktop-build/sidecar/soulseed-backend/": "sidecar/"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
